# Smart AI Chatbot - Environment Configuration

# Server Port (Default is 3000)
PORT=3000

# OpenAI API Key (Required for live OpenAI responses)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Default Model (e.g. gpt-4o-mini, gpt-4o, gpt-3.5-turbo)
DEFAULT_MODEL=gpt-4o-mini